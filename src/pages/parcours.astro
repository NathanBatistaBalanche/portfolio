---
/**
 * src/pages/parcours.astro
 * Page Parcours : hero, résumé en 3 points, puis chronologie (du plus récent au plus ancien).
 * Le Header et le Footer sont dans le Layout.
 */
import Layout from "../layouts/Layout.astro";
import Hexagon from "../components/Hexagon.astro";

// ---------- Résumé ----------
// Icônes dans /public/icons/
const summary = [
  { label: "Études", value: "Bac général · MMI", icon: "orange_graduation" },
  { label: "Intérêts", value: "Web, code, créativité", icon: "orange_folder" },
  { label: "Prochaine étape", value: "Continuer en MMI", icon: "orange_target" },
];

// ---------- Chronologie (la plus récente en premier) ----------
const steps = [
  {
    years: "2026–2027",
    badge: "MMI · 2ème année",
    current: true,
    title: "MMI 2ème année : affirmer ma voie en développement web",
    text: "J’approfondis le développement web, l’UI et la communication, et je cherche une première expérience professionnelle (stage ou alternance).",
    tags: ["Développement web", "UI", "Communication"],
  },
  {
    years: "2024–2026",
    badge: "MMI · 1ère année",
    current: false,
    title: "MMI 1ère année : apprendre et poser les bases",
    text: "J’apprends à coder, à concevoir, à intégrer et à communiquer. Premiers projets web complets, en équipe, pour me préparer à une vie professionnelle dans le numérique.",
    tags: ["Code", "UI", "Communication"],
  },
  {
    years: "2021–2024",
    badge: "Bac général",
    current: false,
    title: "Bac général : Mathématiques et NSI",
    text: "Trois années de bac général avec les spécialités Mathématiques et NSI. Une base solide avant d’entrer en MMI.",
    tags: ["Mathématiques", "NSI", "Fondamentaux"],
  },
];

const container = "mx-auto w-full max-w-7xl px-5 sm:px-8";
---

<Layout>
  <!-- ======================= HERO ======================= -->
  <section class="relative overflow-hidden bg-nuit text-neige" aria-labelledby="parcours-title">
    <div class={`${container} relative py-20 sm:py-28 lg:py-32`}>
      <p class="flex items-center gap-3 font-inter text-sm font-bold text-soleil">
        <Hexagon class="w-4" fill="var(--color-soleil)" />
        MON PARCOURS
      </p>

      <h1
        id="parcours-title"
        class="mt-6 max-w-4xl font-outfit text-5xl font-light leading-[1.08] tracking-tight sm:text-6xl lg:text-7xl"
      >
        Mon parcours se construit étape après étape.
      </h1>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neige/85">
        Trois étapes : le bac général, puis les deux premières années de MMI. Une chronologie simple pour raconter mon
        parcours, sans inventer.
      </p>

      <!-- Nid d'abeilles décoratif -->
      <div class="absolute right-8 top-1/2 hidden h-[12.13rem] w-70 -translate-y-1/2 lg:block xl:right-12" aria-hidden="true">
        <Hexagon class="absolute left-0 top-[3.03rem] w-28 scale-95" fill="var(--color-neige)" stroke="var(--color-abysse)" />
        <Hexagon class="absolute left-[5.25rem] top-0 w-28 scale-95" fill="var(--color-soleil)" />
        <Hexagon class="absolute left-[10.5rem] top-[3.03rem] w-28 scale-95" fill="var(--color-abysse)" />
        <Hexagon class="absolute left-[5.25rem] top-[6.06rem] w-28 scale-95" fill="var(--color-neige)" stroke="var(--color-abysse)" />
      </div>
    </div>
  </section>

  <!-- ======================= RÉSUMÉ ======================= -->
  <section class="bg-neige text-nuit">
    <div class={`${container} pt-12 sm:pt-16`}>
      <ul class="grid gap-8 md:grid-cols-3">
        {
          summary.map((s) => (
            <li class="flex items-center gap-4 px-2">
              <img src={`/icons/${s.icon}.svg`} alt="" width="32" height="auto" class="h-8 w-8 shrink-0" />
              <div>
                <p class="font-inter text-xs font-semibold uppercase tracking-wide text-graphite/55">{s.label}</p>
                <p class="mt-0.5 font-outfit text-lg font-bold">{s.value}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ======================= CHRONOLOGIE ======================= -->
  <section class="bg-neige pb-24 pt-16 text-nuit sm:pb-32 sm:pt-24" aria-label="Chronologie">
    <div class={container}>
      <!--
        Chaque étape : l'hexagone est collé en haut (top-0) et le trait part de son bord bas
        jusqu'en bas de l'étape, donc jusqu'au haut de l'hexagone suivant : ils se touchent.
        Hauteur d'un hexagone w-12 : 3rem × 0,866 = 2,598rem.
      -->
      <ol class="flex flex-col">
        {
          steps.map((step, i) => {
            const isLast = i === steps.length - 1;
            return (
              <li class="relative grid gap-5 pb-16 last:pb-0 md:grid-cols-[22rem_1fr] md:gap-8">
                <Hexagon
                  class="absolute left-1 top-0 z-10 w-12"
                  fill={step.current ? "var(--color-soleil)" : "var(--color-neige)"}
                  stroke="var(--color-cuivre)"
                  strokeWidth={3}
                />
                {!isLast && (
                  <span
                    class="absolute bottom-0 left-7 top-[2.598rem] w-0.5 -translate-x-1/2 bg-cuivre"
                    aria-hidden="true"
                  />
                )}

                <!-- Dates + badge -->
                <div class="pl-[4.5rem]">
                  <p class="flex h-[2.598rem] items-center font-outfit text-2xl font-bold text-cuivre">{step.years}</p>
                  <span
                    class:list={[
                      "mt-3 inline-flex rounded-full px-4 py-1.5 font-inter text-sm font-medium",
                      step.current ? "bg-soleil text-encre" : "border border-cuivre/40 text-graphite",
                    ]}
                  >
                    {step.badge}
                  </span>
                </div>

                <!-- Contenu -->
                <div class="pl-[4.5rem] md:pl-0 md:pt-[0.15rem]">
                  <h2 class="text-balance font-outfit text-2xl font-bold leading-tight text-encre sm:text-3xl">{step.title}</h2>
                  <p class="mt-4 max-w-3xl leading-relaxed text-graphite/60">{step.text}</p>
                  <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-2">
                    {step.tags.map((tag) => (
                      <li class="text-sm text-graphite/55">{tag}</li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Layout>