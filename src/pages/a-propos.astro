---
/**
 * src/pages/a-propos.astro
 * Page À propos : hero, point de départ, repères, ce qu'on peut attendre, centres d'intérêt.
 * Le Header et le Footer sont dans le Layout.
 *
 * Icônes : /public/icons/*.svg — Image : /public/images/homepage_code.webp
 */
import Layout from "../layouts/Layout.astro";
import Hexagon from "../components/Hexagon.astro";

/**
 * Icône « masque » : le SVG sert de forme et la couleur vient de Tailwind (bg-soleil, bg-cuivre…).
 * Pratique pour recolorer une icône sans toucher au fichier.
 */
const maskIcon = (name: string) =>
  `-webkit-mask: url(/icons/${name}.svg) center / contain no-repeat; mask: url(/icons/${name}.svg) center / contain no-repeat;`;

// ---------- Données ----------
const principles = [
  {
    icon: "search",
    title: "Comprendre avant de coder",
    text: "Définir le besoin, poser les bonnes questions et clarifier les contraintes avant de commencer à coder.",
  },
  {
    icon: "repeat",
    title: "Tester tôt",
    text: "Partager une version fonctionnelle permet de valider le code, l’interface et les choix techniques plus vite.",
  },
  {
    icon: "users",
    title: "Travailler avec les autres",
    text: "Écouter les autres, expliquer son code et contribuer au rythme de l’équipe.",
  },
  {
    icon: "sparkles",
    title: "Soigner l’intégration",
    text: "L’intégration compte quand elle rend l’interface cohérente, lisible et accessible.",
  },
];

// Une vraie séquence : la numérotation a du sens ici.
const workflow = [
  { title: "Je spécifie", text: "Besoin, contraintes, stack, priorités et critères de validation avant de commencer." },
  { title: "Je code", text: "HTML, CSS, JavaScript, composants, tests et itérations pour trouver une solution solide." },
  { title: "J’intègre", text: "Intégration front-end, composants réutilisables, responsive et documentation claire." },
  { title: "J’explique", text: "Présentation claire, explication du code, écoute des retours et synthèse des prochaines étapes." },
];

const interests = [
  { icon: "camera", label: "Photo & composition" },
  { icon: "headphones", label: "Podcasts & explication" },
  { icon: "film", label: "Cinéma & narration" },
  { icon: "gamepad", label: "Veille tech" },
];

// Classes réutilisables
const container = "mx-auto w-full max-w-7xl px-5 sm:px-8";
const btnBase =
  "inline-flex items-center gap-3 rounded-xl px-5 py-3 font-outfit text-sm font-bold transition duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-soleil";
const btnDark = `${btnBase} bg-nuit text-neige hover:bg-abysse`;
const btnGhost = `${btnBase} border border-graphite/40 text-nuit hover:border-nuit hover:bg-nuit hover:text-neige`;
---

<Layout>
  <!-- ======================= HERO ======================= -->
  <section class="relative overflow-hidden bg-nuit text-neige" aria-labelledby="apropos-title">
    <div class={`${container} relative py-20 sm:py-28 lg:py-32`}>
      <p class="flex items-center gap-3 font-inter text-sm font-bold text-soleil">
        <Hexagon class="w-4" fill="var(--color-soleil)" />
        FAIRE CONNAISSANCE
      </p>

      <h1
        id="apropos-title"
        class="mt-6 max-w-4xl font-outfit text-5xl font-light leading-[1.08] tracking-tight sm:text-6xl lg:text-7xl"
      >
        Du code au produit, avec méthode et curiosité.
      </h1>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neige/85">
        Ce portfolio montre ce que je sais déjà faire en MMI, ce que j’apprends en développement web et la façon dont
        j’aime aborder un projet.
      </p>

      <!-- Nid d'abeilles décoratif -->
      <div class="absolute right-8 top-1/2 hidden h-[12.13rem] w-70 -translate-y-1/2 lg:block xl:right-12" aria-hidden="true">
        <Hexagon class="absolute left-0 top-[3.03rem] w-28 scale-95" fill="var(--color-neige)" stroke="var(--color-abysse)" />
        <Hexagon class="absolute left-[5.25rem] top-0 w-28 scale-95" fill="var(--color-soleil)" />
        <Hexagon class="absolute left-[10.5rem] top-[3.03rem] w-28 scale-95" fill="var(--color-azur)" />
        <Hexagon class="absolute left-[5.25rem] top-[6.06rem] w-28 scale-95" fill="var(--color-neige)" stroke="var(--color-abysse)" />
      </div>
    </div>
  </section>

  <!-- ======================= POINT DE DÉPART ======================= -->
  <section class="bg-neige text-nuit" aria-labelledby="depart-title">
    <div class={`${container} grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-[5fr_6fr] lg:gap-20`}>
      <!-- Visuel -->
      <div class="relative mx-auto w-full max-w-lg lg:mx-0 lg:max-w-none">
        <div class="overflow-hidden rounded-tl-3xl rounded-tr-[4.5rem] rounded-br-3xl rounded-bl-[4.5rem] shadow-2xl shadow-nuit/20">
          <img
            src="/images/homepage_code.webp"
            alt="Code affiché sur un écran d’ordinateur"
            width="640"
            height="800"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>

        <div class="absolute bottom-0 left-4 rounded-2xl bg-nuit px-5 py-3 text-neige sm:left-5">
          <p class="font-outfit text-base font-bold">Nathan Batista Balanche</p>
          <p class="mt-0.5 text-xs text-neige/75">Étudiant MMI · Voie développement web</p>
        </div>

      </div>

      <!-- Texte -->
      <div>
        <p class="flex items-center gap-3 font-inter text-xs font-bold text-cuivre">
          <Hexagon class="w-3.5" fill="var(--color-soleil)" />
          MON POINT DE DÉPART
        </p>

        <h2 id="depart-title" class="mt-4 max-w-xl font-outfit text-3xl font-bold leading-tight text-encre sm:text-4xl">
          Je construis des interfaces web avec méthode et curiosité.
        </h2>

        <p class="mt-7 max-w-2xl leading-relaxed text-graphite/60">
          En MMI, je m’appuie sur le développement web comme voie principale. Je comprends mieux chaque semaine comment
          lier code, interface, navigation et message pour construire une expérience utile et cohérente.
        </p>
        <p class="mt-5 max-w-2xl leading-relaxed text-graphite/60">
          Je ne me présente pas comme expert, mais comme un étudiant qui sait coder, intégrer, tester et expliquer son
          travail. Je sais demander de l’aide, résoudre des problèmes techniques et améliorer un projet grâce aux
          retours.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/parcours" class={btnDark}>
            Voir mon parcours
            <img src="/icons/journey.svg" alt="" width="18" height="18" class="h-[18px] w-[18px]" />
          </a>
          <a href="/cv-nathan-batista-balanche.pdf" download="CV-Nathan-Batista-Balanche.pdf" class={btnGhost}>
            Télécharger mon CV
            <img src="/icons/download.svg" alt="" width="18" height="18" class="h-[18px] w-[18px]" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= REPÈRES ======================= -->
  <section class="bg-nuit text-neige" aria-labelledby="reperes-title">
    <div class={`${container} py-20 sm:py-28`}>
      <p class="flex items-center gap-3 font-inter text-xs font-bold text-soleil">
        <Hexagon class="w-3.5" fill="var(--color-soleil)" />
        MES REPÈRES
      </p>

      <h2 id="reperes-title" class="mt-4 max-w-3xl font-outfit text-3xl font-medium leading-tight sm:text-4xl lg:text-5xl">
        Une ambition simple : coder utile, intégrer propre et apprendre vite.
      </h2>
      <p class="mt-5 max-w-2xl text-neige/80">
        Ces principes m’aident à coder, intégrer, tester et expliquer mon travail avec méthode et humilité.
      </p>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <li class="rounded-3xl bg-abysse p-6 sm:p-7">
              <span class="block h-6 w-6 bg-soleil" style={maskIcon(p.icon)} aria-hidden="true" />
              <h3 class="mt-5 font-outfit text-xl font-semibold leading-snug">{p.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-neige/75">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ======================= EN PRATIQUE ======================= -->
  <section class="bg-neige text-nuit" aria-labelledby="pratique-title">
    <div class={`${container} grid gap-12 py-20 sm:py-28 lg:grid-cols-[5fr_6fr] lg:gap-20`}>
      <div>
        <p class="flex items-center gap-3 font-inter text-xs font-bold text-cuivre">
          <Hexagon class="w-3.5" fill="var(--color-soleil)" />
          EN PRATIQUE
        </p>
        <h2 id="pratique-title" class="mt-4 font-outfit text-3xl font-bold leading-tight text-encre sm:text-4xl lg:text-5xl">
          Ce que vous pouvez attendre de mon travail.
        </h2>
        <p class="mt-5 max-w-md text-graphite/60">
          Pas des promesses démesurées : du code propre, des explications claires et une vraie volonté d’apprendre.
        </p>
      </div>

      <ol class="flex flex-col gap-9">
        {
          workflow.map((w, i) => (
            <li class="grid grid-cols-[3rem_1fr] items-baseline gap-x-4 gap-y-2 sm:grid-cols-[3.5rem_9rem_1fr] sm:gap-x-6">
              <span class="font-outfit text-xl font-bold text-cuivre">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="font-outfit text-lg font-bold text-encre">{w.title}</h3>
              <p class="col-span-2 col-start-1 text-sm leading-relaxed text-graphite/55 sm:col-span-1 sm:col-start-auto">
                {w.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>