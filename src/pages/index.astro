    background-size: 120px 67px;
    mask-image: radial-gradient(ellipse at 80% 50%, #000 0%, transparent 80%);
  }

  /* ---------- Texte ---------- */
  .ix-grad {
    background: linear-gradient(100deg, var(--color-miel), var(--color-soleil) 50%, var(--color-safran));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ix-grad-stroke {
    background: linear-gradient(135deg, var(--color-miel), var(--color-soleil) 45%, var(--color-safran));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 10px 18px color-mix(in srgb, var(--color-soleil) 35%, transparent));
  }
  .ix-underline {
    background-image: linear-gradient(90deg, var(--color-soleil), var(--color-safran));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 100% 0.22em;
    padding-bottom: 0.05em;
  }
  .ix-caret {
    display: inline-block;
    width: 0.07em;
    height: 0.85em;
    margin-left: 0.12em;
    vertical-align: -0.08em;
    border-radius: 2px;
    background: var(--color-soleil);
    animation: ix-blink 1.1s steps(2, start) infinite;
  }
  @keyframes ix-blink {
    to {
      visibility: hidden;
    }
  }

  /* ---------- Hexagone en clip-path (badges d'icônes) ---------- */
  .ix-hex {
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
  }

  /* ---------- Cluster 01 ---------- */
  :global(.ix-cluster svg) {
    animation: ix-pulse 5s ease-in-out infinite;
    transform-origin: center;
  }
  :global(.ix-cluster svg:nth-child(2)) {
    animation-delay: -1.2s;
  }
  :global(.ix-cluster svg:nth-child(3)) {
    animation-delay: -2.4s;
  }
  :global(.ix-cluster svg:nth-child(4)) {
    animation-delay: -3.6s;
  }
  @keyframes ix-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ---------- Lueurs / flottement ---------- */
  .ix-drift {
    animation: ix-drift 16s ease-in-out infinite;
  }
  .ix-drift-rev {
    animation-direction: reverse;
    animation-delay: -8s;
  }
  @keyframes ix-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(40px, 18px, 0);
    }
  }

  .ix-float {
    animation: ix-float 9s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes ix-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(var(--r, 0deg));
    }
    50% {
      transform: translate3d(0, -14px, 0) rotate(calc(var(--r, 0deg) + 7deg));
    }
  }

  .ix-ping {
    animation: ix-ping 1.8s ease-out infinite;
  }
  @keyframes ix-ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-soleil) 70%, transparent);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .ix-ping-dark {
    animation: ix-ping-dark 1.8s ease-out infinite;
  }
  @keyframes ix-ping-dark {
    0% {
      box-shadow: 0 0 0 0 rgb(15 15 15 / 0.5);
    }
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  /* ---------- Apparition du hero au chargement ---------- */
  .ix-in {
    animation: ix-in 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 100ms + 120ms);
  }
  @keyframes ix-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  /* ---------- Apparition au scroll (activée par le script) ---------- */
  .ix-ready [data-reveal] {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s ease,
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0ms);
  }
  .ix-ready [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* ---------- Reflet des boutons (même signature que Header / Footer) ---------- */
  .ix-shine::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    width: 40%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.5), transparent);
    transform: translateX(-220%) skewX(-20deg);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ix-shine:hover::before,
  .ix-shine:focus-visible::before {
    transform: translateX(520%) skewX(-20deg);
  }

  /* ---------- Bandeau défilant ---------- */
  .ix-marquee {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ix-marquee-track {
    animation: ix-marquee 45s linear infinite;
  }
  .ix-marquee:hover .ix-marquee-track {
    animation-play-state: paused;
  }
  @keyframes ix-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- Point voyageur ---------- */
  .ix-travel {
    animation: ix-travel 9s ease-in-out infinite alternate;
  }
  @keyframes ix-travel {
    from {
      left: 0;
    }
    to {
      left: calc(100% - 0.75rem);
    }
  }

  /* ---------- Inclinaison de l'image du hero ---------- */
  .ix-tilt {
    transition: transform 0.35s ease;
    will-change: transform;
  }

  /* ---------- CTA ---------- */
  .ix-cta {
    background: linear-gradient(115deg, var(--color-soleil) 0%, var(--color-miel) 55%, var(--color-soleil) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const root = document.getElementById("ix");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !reduceMotion) {
    // ----- Apparition au scroll (sans JS ou animations réduites : tout reste visible) -----
    if ("IntersectionObserver" in window) {
      root.classList.add("ix-ready");
      const reveal = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              reveal.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );
      root.querySelectorAll("[data-reveal]").forEach((el) => reveal.observe(el));

      // ----- Compteurs du hero -----
      const format = (el: HTMLElement, v: number) =>
        String(Math.round(v)).padStart(Number(el.dataset.pad ?? 0), "0") + (el.dataset.suffix ?? "");

      const counters = root.querySelectorAll<HTMLElement>("[data-count]");
      counters.forEach((el) => (el.textContent = format(el, 0)));

      const counting = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const to = Number(el.dataset.to ?? 0);
            const start = performance.now();
            const duration = 1400;
            const step = (now: number) => {
              const t = Math.min((now - start) / duration, 1);
              el.textContent = format(el, to * (1 - Math.pow(1 - t, 3)));
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
            counting.unobserve(el);
          });
        },
        { threshold: 0.6 },
      );
      counters.forEach((el) => counting.observe(el));
    }

    // ----- Inclinaison 3D de l'image (souris uniquement) -----
    if (window.matchMedia("(hover: hover)").matches) {
      root.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
        el.addEventListener("pointermove", (e) => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          el.style.transform = `perspective(900px) rotateX(${(-y * 6).toFixed(2)}deg) rotateY(${(x * 8).toFixed(2)}deg)`;
        });
        el.addEventListener("pointerleave", () => {
          el.style.transform = "";
        });
      });
    }
  }
</script>